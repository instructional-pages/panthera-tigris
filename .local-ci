#!/usr/bin/env bash
# Checks for this repo, run by `local-ci`. Cheapest first.
set -euo pipefail
cd "$(dirname "$0")"

# Research dossier: every citation resolves, every source is cited.
python3 -m unittest discover -s tests -q
python3 scripts/check_research.py docs/research

# Site: install, typecheck, unit tests, build, bundle budget (gzipped, whole download).
npm ci --no-audit --no-fund --loglevel=error
npx tsc --noEmit
npm test
npx vite build
python3 scripts/check_bundle.py dist 135 90
